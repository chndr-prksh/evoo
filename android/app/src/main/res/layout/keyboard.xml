<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="Tap the mic and speak"
        android:textColor="#B8BCC6"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/switch_keyboard" style="@style/Key" android:text="🌐" android:contentDescription="Switch keyboard" />
        <TextView android:id="@+id/undo" style="@style/Key" android:text="↶" android:contentDescription="Undo the last dictation" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4">
            <ImageView
                android:id="@+id/mic"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_idle"
                android:contentDescription="Dictate"
                android:padding="18dp"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <TextView android:id="@+id/backspace" style="@style/Key" android:text="⌫" android:contentDescription="Delete" />
        <TextView android:id="@+id/enter" style="@style/Key" android:text="⏎" android:contentDescription="Enter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/comma" style="@style/Key" android:text="," />
        <TextView android:id="@+id/period" style="@style/Key" android:text="." />
        <TextView android:id="@+id/question" style="@style/Key" android:text="\?" />
        <TextView android:id="@+id/space" style="@style/Key" android:layout_weight="3" android:text="space" android:textSize="14sp" />
        <TextView android:id="@+id/exclaim" style="@style/Key" android:text="!" />
        <TextView android:id="@+id/at" style="@style/Key" android:text="\@" />
    </LinearLayout>
</LinearLayout>
