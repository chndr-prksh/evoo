<Project Sdk="Microsoft.NET.Sdk">
  <!-- Evoo's rules in plain C# (no Windows APIs): fast to test, shared by the app and the end-to-end check. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Evoo.Core</RootNamespace>
  </PropertyGroup>
</Project>
